# Use the production origin, including https://
SITE_URL=
# Optional token for the public GitHub Events API
GITHUB_TOKEN=
# Full FastAPI endpoint, for example https://your-api.example/api/v1/assistant/query
ASSISTANT_URL=
ASSISTANT_API_KEY=
# Body field accepted by your FastAPI adapter (default: query)
ASSISTANT_QUERY_FIELD=query
# Optional Resend integration
RESEND_API_KEY=
CONTACT_FROM=
CONTACT_TO=
# Verified public contact details only
PUBLIC_EMAIL=
RESUME_URL=
# Optional same-origin analytics path or trusted HTTPS script URL
ANALYTICS_SCRIPT_URL=
